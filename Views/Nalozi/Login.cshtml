@model dynamic
@using (Html.BeginForm("Login", "Nalog", FormMethod.Post, new { @class = "form-horizontal" }))
{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";

    @Html.AntiForgeryToken()
    <div>
        @Html.Label("Korisničko ime")
        @Html.TextBox("username", null, new { @class = "form-control", required = "required" })
    </div>
    <div>
        @Html.Label("Lozinka")
        @Html.Password("password")
    </div>
    <div>
        <label><input type="checkbox" name="rememberMe" /> Zapamti</label>
    </div>
    <input type="submit" value="Log In" />
    @Html.ValidationSummary()
}

<h2>Registracija</h2>

