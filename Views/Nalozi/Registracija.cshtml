@model A_Gde_Si_Ti_Pub.Models.Korisnik
@{
    ViewBag.Title = "Registracija";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Registracija</h2>

@using (Html.BeginForm("Register", "Nalog", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Username, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", required = "required", type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Password, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Potvrdi Lozinku</label>
        <div class="col-md-10">
            <input type="password" name="confirmPassword" class="form-control" required="required" />
            @Html.ValidationMessage("confirmPassword", "", new { @class = "text-danger" }) <!-- Custom error in controller -->
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Registruj se" class="btn btn-success" />
        </div>
    </div>

    <p>
        Već imate nalog? @Html.ActionLink("Prijavite se", "Login", "Nalozi")
    </p>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
