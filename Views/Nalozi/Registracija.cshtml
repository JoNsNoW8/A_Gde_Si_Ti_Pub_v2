@model A_Gde_Si_Ti_Pub.Models.Korisnik
@{
    ViewBag.Title = "Registracija";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Registracija</h2>

@using (Html.BeginForm("Registracija", "Nalozi", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Ime, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Ime, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(m => m.Ime, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Korisničko ime</label>
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", required = "required", type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Lozinka</label>
        <div class="col-md-10">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Potvrdi lozinku</label>
        <div class="col-md-10">
            <input type="password" name="potvrdaLozinke" class="form-control" required="required" />
            @Html.ValidationMessage("potvrdaLozinke", "", new { @class = "text-danger", id = "confirmError" }) <!-- Custom error in controller -->
        </div>
    </div>

    //biranje uloge
    /*
    <div class="form-group">
        <label class="control-label col-md-2">Uloga</label>
        <div class="col-md-10">
            @Html.DropDownList("Uloga", new SelectList(new Dictionary<string, string> { { "Korisnik", "Korisnik" }, { "Admin", "Administrator" } }), "Izaberite ulogu", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Uloga, "", new { @class = "text-danger" })
            <small class="text-muted">Nova registracija će biti kao 'Korisnik'. Admin nalozi se kreiraju posebno.</small>
        </div>
    </div>
    */
    <br />
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Registruj se" class="btn btn-success" />
        </div>
    </div>

    <p>
        Već imate nalog? @Html.ActionLink("Prijavite se", "Login", "Nalozi")
    </p>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Optional: Client-side password match check (shows error before submit, reduces frustration)
        $(function () {
            $('#potvrdaLozinke').on('input', function () {
                var password = $('#Password').val();
                var confirm = $(this).val();
                var errorDiv = $('#confirmError');
                if (password !== confirm && confirm.length > 0) {
                    errorDiv.text('Lozinke se ne poklapaju.'); // Preview error
                } else {
                    errorDiv.text(''); // Clear
                }
            });
        });
    </script>
    }

