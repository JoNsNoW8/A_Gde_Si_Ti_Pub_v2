@model List<A_Gde_Si_Ti_Pub.Models.Porudzbina>
@{
    ViewBag.Title = "Upravljanje Porudžbinama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="naslov">Upravljanje porudžbinama</h2>
<p class="podnaslov">
    Ovde možete pregledati sve porudžbine, urediti status ili obrisati.
</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>@Html.ActionLink("Nazad na profil", "Profil", "Home", null, new { @class = "btn btn-secondary" })</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <p>Nema porudžbina u sistemu.</p>
    </div>
}
else
{
    <table class="table table-bordered table-striped text-center">
        <thead class="thead-dark">
            <tr>
                <th>ID Porudžbine</th>
                <th>Korisnik</th>
                <th>Datum</th>
                <th>Ukupna cena</th>
                <th>Status</th>
                <th>Proizvodi</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var porudzbina in Model)
            {
                <tr>
                    <td><strong>@porudzbina.PorudzbinaId</strong></td>
                    <td>@(porudzbina.Korisnik?.Username ?? "Nepoznato")</td>
                    <td>@porudzbina.Datum.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-success">@($"{porudzbina.UkupnaCena:N2} RSD")</td>
                    <td>
                        <span style="color:black" class="badge badge-@(porudzbina.Status == "Obrada" ? "warning" : porudzbina.Status == "Poslato" ? "info" : "success")">
                            @porudzbina.Status
                        </span>
                    </td>
                    <td>
                        @if (porudzbina.DeloviPorudzbine != null && porudzbina.DeloviPorudzbine.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var deo in porudzbina.DeloviPorudzbine.Take(3)) //prikaz prva tri proizvoda
                                {
                                    <li>
                                        @deo.Proizvod.Naziv - @($"{deo.Cena:N2} RSD") po kom
                                    </li>
                                }
                                @if (porudzbina.DeloviPorudzbine.Count > 3)
                                {
                                    <li class="text-muted">... i još @(porudzbina.DeloviPorudzbine.Count - 3) stavki</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">Nema stavki</span>
                        }
                    </td>
                    <td>
                        @using (Html.BeginForm("UrediPorudzbinu", "Admin", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("porudzbinaId", porudzbina.PorudzbinaId)

                        <div class="input-group input-group-sm">
                            @Html.DropDownList("status",
                            new SelectList(new[] { "Obrada", "Poslato", "Isporučeno", "Otkazano" }, porudzbina.Status),
                            new { @class = "form-control" })

                            <button type="submit" class="btn btn-primary">Ažuriraj</button>
                        </div>
                        }
                    <br />
                        @using (Html.BeginForm("ObrisiPorudzbinu", "Admin", new { porudzbinaId = porudzbina.PorudzbinaId }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Sigurno želite da obrišete porudžbinu ID @porudzbina.PorudzbinaId? Ovo je nepovratno.');">
                                Obriši
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center mt-3">
        <p>Ukupno porudžbina: @Model.Count</p>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
