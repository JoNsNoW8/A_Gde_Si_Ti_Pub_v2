@model List<A_Gde_Si_Ti_Pub.Models.Proizvod>
@{
    ViewBag.Title = "Upravljanje Proizvodima";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Upravljanje Proizvodima</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>
    @Html.ActionLink("Dodaj Novi Proizvod", "DodajProizvod", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Naziv</th>
            <th>Opis</th>
            <th>Cena</th>
            <th>Slika</th>
            <th>Status (Dostupan)</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var proizvod in Model)
        {
            <tr>
                <td>@proizvod.ProizvodId</td>
                <td>@proizvod.Naziv</td>
                <td>@proizvod.Opis</td>
                <td>@proizvod.Cena.ToString("C")</td>
                <td>
                    @if (!string.IsNullOrEmpty(proizvod.Slika))
                    {
                        <img src="@proizvod.Slika" alt="@proizvod.Naziv" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/50?text=Slika'" />
                    }
                    else
                    {
                        <span class="text-muted">Nema slike</span>
                    }
                </td>
                <!-- <td><img src="@proizvod.Slika" alt="@proizvod.Naziv" style="width: 50px; height: 50px;" onerror="this.src='https://via.placeholder.com/50?text=Slika'" /></td>-->
                <td>@(proizvod.Status ? "Da" : "Ne")</td>
                <td>
                    @Html.ActionLink("Izmeni", "IzmeniProizvod", new { id = proizvod.ProizvodId }, new { @class = "btn btn-warning btn-sm" })
                    |
                    @Html.ActionLink("Obriši", "ObrisiProizvod", new { id = proizvod.ProizvodId }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Sigurno želite da obrišete " + proizvod.Naziv + "?');" })
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>Nema proizvoda. @Html.ActionLink("Dodajte prvi", "DodajProizvod")</p>
}
