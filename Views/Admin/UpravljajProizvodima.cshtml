@model List<A_Gde_Si_Ti_Pub.Models.Proizvod>
@{
    ViewBag.Title = "Upravljanje Proizvodima";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="naslov">Upravljanje proizvodima</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>
    @Html.ActionLink("Dodaj novi proizvod", "DodajProizvod", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Nazad na profil", "Profil", "Home", null, new { @class = "btn btn-secondary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Naziv</th>
            <th>Opis</th>
            <th>Cena</th>
            <th>Status</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var proizvod in Model)
        {
            <tr>
                <td>@proizvod.ProizvodId</td>
                <td>@proizvod.Naziv</td>
                <td>@proizvod.Opis</td>
                <td>@($"{proizvod.Cena:N2} RSD")</td>
                <td>@(proizvod.Status ? "Da" : "Ne")</td>
                <td>
                    @Html.ActionLink("Izmeni", "IzmeniProizvod", new { id = proizvod.ProizvodId }, new { @class = "btn btn-secondary btn-sm" })
                    |
                    @Html.ActionLink("Obriši", "ObrisiProizvod", new { id = proizvod.ProizvodId }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Sigurno želite da obrišete " + proizvod.Naziv + "?');" })
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>Nema proizvoda. @Html.ActionLink("Dodajte prvi", "DodajProizvod")</p>
}
