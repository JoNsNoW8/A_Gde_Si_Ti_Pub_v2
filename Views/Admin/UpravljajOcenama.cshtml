@model List<A_Gde_Si_Ti_Pub.Models.Ocena>
@{
    ViewBag.Title = "Upravljanje Ocenama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="naslov">Upravljanje ocenama</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>
    @Html.ActionLink("Nazad na profil", "Profil","Home", null, new { @class = "btn btn-secondary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ocena</th>
            <th>Komentar</th>
            <th>Korisnik</th>
            <th>Proizvod</th>
            <th>Datum</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ocena in Model)
        {
            <tr>
                <td>@ocena.OcenaId</td>
                <td>@ocena.Vrednost / 5</td>
                <td>@ocena.Komentar</td>
                <td>@(ocena.Korisnik != null ? ocena.Korisnik.Username : "Nepoznato")</td>
                <td>@(ocena.ProizvodId.HasValue ? ocena.Proizvod?.Naziv : "Opšta ocena")</td>
                <td>@ocena.Datum.ToShortDateString()</td>
                <td>@Html.ActionLink("Obriši", "ObrisiOcenu", new { id = ocena.OcenaId }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Sigurno želite da obrišete ocenu?');" })</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>Nema ocena za upravljanje.</p>
}
