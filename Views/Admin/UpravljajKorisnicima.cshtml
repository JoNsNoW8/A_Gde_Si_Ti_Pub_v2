@model List<A_Gde_Si_Ti_Pub.Models.Korisnik>
@{
    ViewBag.Title = "Upravljanje Korisnicima";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Upravljanje korisnicima</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>
    @Html.ActionLink("Dodaj korisnika", "KreirajKorisnika", null, new { @class = "btn btn-success" })
    @Html.ActionLink("Dodaj administratora", "KreirajAdmina", null, new { @class = "btn btn-warning" })
    @Html.ActionLink("Nazad na početnu", "Index", "Home", null, new { @class = "btn btn-secondary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ime</th>
            <th>Korisničko ime</th>
            <th>Email</th>
            <th>Uloga</th>
            <th>Aktivan</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var k in Model)
        {
            <tr>
                <td>@k.KorisnikId</td>
                <td>@k.Ime</td>
                <td>@k.Username</td>
                <td>@k.Email</td>
                <td>@k.Uloga</td>
                <td>@(k.IsActive ? "Da" : "Ne")</td>
                <td>
                    @if (k.Uloga != "Admin")
                    {
                        @Html.ActionLink("Deaktiviraj/Aktiviraj", "ToggleKorisnik", new { id = k.KorisnikId }, new { @class = "btn btn-warning btn-sm" })
                    }
                    else
                    {
                        <span style="color:black" class="badge badge-danger">Admin (ne može se menjati)</span>
                    }

                    @Html.ActionLink("Izmeni", "IzmeniKorisnika", new { id = k.KorisnikId }, new { @class = "btn btn-warning btn-sm" })
                    |
                    @Html.ActionLink("Obriši", "ObrisiKorisnika", new { id = k.KorisnikId }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Sigurno želite da obrišete korisnika " + k.Ime + "?');" })
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
