@model A_Gde_Si_Ti_Pub.Models.Korisnik
@{
    ViewBag.Title = "Kreiraj Novog Admina";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="naslov">Kreiraj novog administratora</h2>

<p class="podnaslov">Ovaj nalog će imati puna administrator prava. Koristite odgovorno.</p>

@using (Html.BeginForm("KreirajAdmina", "Admin", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        <label class="control-label col-md-2">Korisničko ime</label>
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", required = "required", placeholder = "Korisničko ime (npr. admin1)" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required", placeholder = "Email (npr. admin1@mail.com)" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Lozinka</label>
        <div class="col-md-10">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "Password", required = "required", placeholder = "Lozinka (min. 6 karaktera)" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2">Potvrdi lozinku</label>
        <div class="col-md-10">
            <input type="password" name="potvrdaLozinke" id="potvrdaLozinke" class="form-control" required="required" placeholder="Ponovi lozinku" />
            @Html.ValidationMessage("potvrdaLozinke", "", new { @class = "text-danger", id = "confirmError" })
        </div>
    </div>
    <br />
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Kreiraj administratora" class="btn btn-success" />
            @Html.ActionLink("Nazad", "UpravljajKorisnicima", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            $('#potvrdaLozinke').on('input', function () {
                var password = $('#Password').val();
                var confirm = $(this).val();
                var errorDiv = $('#confirmError');
                if (password !== confirm && confirm.length > 0) {
                    errorDiv.text('Lozinke se ne poklapaju.');
                } else {
                    errorDiv.text('');
                }
            });
        });
    </script>
}
