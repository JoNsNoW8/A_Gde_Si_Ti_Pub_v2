@model A_Gde_Si_Ti_Pub.Models.Korisnik
@{
    ViewBag.Title = "Profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<h2>Profil</h2>

<div class="container">
    <h2>Moj Profil</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4>Vaši Podaci</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Korisničko Ime:</dt>
                        <dd class="col-sm-9">@Model.Username</dd>
                        <dt class="col-sm-3">Email:</dt>
                        <dd class="col-sm-9">@Model.Email</dd>
                        <dt class="col-sm-3">Uloga:</dt>
                        <dd class="col-sm-9">@(Model.Uloga == "Admin" ? "Administrator" : "Korisnik")</dd>
                        <dt class="col-sm-3">Status:</dt>
                        <dd class="col-sm-9">@(Model.IsActive ? "Aktivan" : "Neaktivan")</dd>
                        <!-- Optional: Add more if you expand model (e.g., Datum Kreiranja) -->
                    </dl>
                </div>
            </div>
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="mt-4">
            <h3>Admin Panel - Upravljanje</h3>
            <p>Kao administrator, možete upravljati sledećim sekcijama:</p>
            <div class="row">
                <!-- Users Management Card -->
                <div class="col-md-3 mb-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Korisnici</h5>
                            <p class="card-text">Prikaži listu, dodaj nove korisnike ili admine.</p>
                            <a href="@Url.Action("UpravljajKorisnicima", "Admin")" class="btn btn-info btn-block">Prikaži Korisnike</a>
                            <a href="@Url.Action("KreirajKorisnika", "Admin")" class="btn btn-success btn-block mt-1">Dodaj Korisnika</a>
                            <a href="@Url.Action("KreirajAdmina", "Admin")" class="btn btn-warning btn-block mt-1">Dodaj Admina</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Ocene (Reviews)</h5>
                            <p class="card-text">Odobri, obriši ili upravljaj ocenama korisnika.</p>
                            <a href="@Url.Action("UpravljajOcenama", "Admin")" class="btn btn-info btn-block">Upravljaj Ocenama</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Prodavnica (Store)</h5>
                            <p class="card-text">Dodaj, izmeni ili obriši proizvode.</p>
                            <a href="@Url.Action("UpravljajProizvodima", "Admin")" class="btn btn-info btn-block">Upravljaj Proizvodima</a>
                            <a href="@Url.Action("DodajProizvod", "Admin")" class="btn btn-success btn-block mt-1">Dodaj Proizvod</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Porudžbine (Orders)</h5> <!---porudzbine u progresu-->
                            <p class="card-text">Upravljaj porudžbinama.</p>
                            <a href="@Url.Action("UpravljajPorudzbinama", "Admin")" class="btn btn-info btn-block">Prikaži Porudžbine</a>
                            <!-- Placeholder: Add more buttons later, e.g., @Html.ActionLink("Nova Porudžbina", "KreirajPorudzbinu", "Admin") -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Regular User: Simple message -->
        <div class="alert alert-info mt-4">
            <p>Kao obični korisnik, možete pregledati profil i prodavnicu. Za admin funkcije, kontaktirajte administratora.</p>
        </div>
    }

    <!-- Common Navigation Buttons (for all users) -->
<div class="text-center mt-4">
    @Html.ActionLink("Moje Porudžbine", "MojeKupovine", "Prodavnica", null, new { @class = "btn btn-info" })
    @Html.ActionLink("Izmeni Profil", "EditProfil", "Home", null, new { @class = "btn btn-primary" }) <!-- Placeholder for future edit -->
    @Html.ActionLink("Nazad na početnu", "Index", "Home", null, new { @class = "btn btn-secondary" })
</div>
</div>

