@model A_Gde_Si_Ti_Pub.Models.Korisnik
@{
    ViewBag.Title = "Profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container">
    <h2 class="naslov">Moj Profil</h2>
    <br />
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header proizvod">
                    <h4>Vaši Podaci</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Ime:</dt>
                        <dd class="col-sm-8">@Model.Ime</dd>
                        <dt class="col-sm-4">Korisničko ime:</dt>
                        <dd class="col-sm-8">@Model.Username</dd>
                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                        <dt class="col-sm-4">Uloga:</dt>
                        <dd class="col-sm-8">@(Model.Uloga == "Admin" ? "Administrator" : "Korisnik")</dd>
                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">@(Model.IsActive ? "Aktivan" : "Neaktivan")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="mt-4">
            <h3>Admin Panel - Upravljanje</h3>
            <p>Kao administrator, možete upravljati sledećim sekcijama:</p>
            <div class="row">
                <!-- Users Management Card -->
                <div class="col-md-3 mb-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Korisnici</h5>
                            <p class="card-text">Upravljaj nalozima korisnika.</p>
                            <a href="@Url.Action("UpravljajKorisnicima", "Admin")" class="btn btn-info btn-block">Upravljaj korisnicima</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Ocene</h5>
                            <p class="card-text">Upravljaj ocenama korisnika.</p>
                            <a href="@Url.Action("UpravljajOcenama", "Admin")" class="btn btn-info btn-block">Upravljaj ocenama</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Prodavnica</h5>
                            <p class="card-text">Upravljaj proizvodima.</p>
                            <a href="@Url.Action("UpravljajProizvodima", "Admin")" class="btn btn-info btn-block">Upravljaj proizvodima</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="card text-center">
                        <div class="card-body">
                            <h5 class="card-title">Porudžbine</h5>
                            <p class="card-text">Upravljaj porudžbinama.</p>
                            <a href="@Url.Action("UpravljajPorudzbinama", "Admin")" class="btn btn-info btn-block">Prikaži porudžbine</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            @Html.ActionLink("Izmeni Profil", "IzmeniProfil", "Home", null, new { @class = "btn btn-primary" })
            @Html.ActionLink("Nazad na početnu", "Index", "Home", null, new { @class = "btn btn-secondary" })
        </div>
    }
    else
    {
        <div class="text-center mt-4">
            @Html.ActionLink("Moje Porudžbine", "MojeKupovine", "Prodavnica", null, new { @class = "btn btn-info" })
            @Html.ActionLink("Izmeni Profil", "IzmeniProfil", "Home", null, new { @class = "btn btn-primary" })
            @Html.ActionLink("Nazad na početnu", "Index", "Home", null, new { @class = "btn btn-secondary" })
        </div>
    }


</div>

