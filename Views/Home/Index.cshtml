@{
    ViewBag.Title = "Početna";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ocene = ViewBag.Ocene as List<A_Gde_Si_Ti_Pub.Models.Ocena>;
    var isAuthenticated = ViewBag.IsAuthenticated as bool? ?? false;
    var currentUserId = ViewBag.CurrentUserId as int? ?? 0;
    var proizvodi = ViewBag.Proizvodi as List<A_Gde_Si_Ti_Pub.Models.Proizvod>; // optional
}

<div class="container">
    <h2>Šta naši kupci kažu o nama</h2>

    <div id="reviewsSection">
        @if (ocene != null && ocene.Any())
        {
            <div class="row">
                @foreach (var ocena in ocene)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">@ocena.Vrednost / 5 Zvezdica</h5>
                                <p class="card-text">@ocena.Komentar</p>
                                <small class="text-muted">
                                    Od: @ocena.Korisnik?.Username <br />
                                    @if (ocena.ProizvodId.HasValue)
                                    {
                                        @:Za proizvod: @ocena.Proizvod?.Naziv <br />
                                    }
                                    else
                                    {
                                        @:Opšta ocena kafića <br />
                                    }
                                    Datum: @ocena.Datum.ToShortDateString() <!-- Fixed: Use CreatedDate from model -->
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>Još nema ocena. Budi prvi!</p>
        }
    </div>

    <div class="text-center mt-4">
        <button id="addReviewBtn" class="btn btn-primary">Dodaj Svoju Ocenu</button>
    </div>

    @if (isAuthenticated)
    {
        <!-- Forma za dodavanje ocene (ulogovani korisnik) -->
        <div id="addReviewForm" style="display: none;" class="mt-4">
            <h3>Dodaj Ocenu</h3>
            @using (Html.BeginForm("AddReview", "Home", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.Label("Ocena (1-5)", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("Vrednost", new SelectList(Enumerable.Range(1, 5)), "Izaberite ocenu", new { @class = "form-control", required = "required" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Komentar", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextArea("Komentar", null, new { @class = "form-control", rows = "3", required = "required", placeholder = "Vaš komentar o kafiću ili proizvodu..." })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Za Proizvod (opciono)", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("ProizvodId", new SelectList(proizvodi ?? new List<A_Gde_Si_Ti_Pub.Models.Proizvod>(), "ProizvodId", "Naziv"), "Opšta ocena kafića", new { @class = "form-control" })
                    </div>
                </div>

                <div class="form-group mt-3">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Pošalji Ocenu" class="btn btn-success" />
                        <button type="button" id="cancelReviewBtn" class="btn btn-secondary">Otkaži</button>
                    </div>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
            }
        </div>
    }
</div>

<!-- Modal za registraciju -->
<div class="modal fade" id="registerModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrujte Se da Ostavite Ocenu</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <!-- Embedded Registration Form (reuses structure from your Registracija view) -->
                @model A_Gde_Si_Ti_Pub.Models.Korisnik
                <form id="registerFormInModal" class="form-horizontal">
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div id="modalErrors"></div> <!-- For AJAX errors -->

                    <div class="form-group">
                        @Html.LabelFor(m => m.Username, new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", required = "required", placeholder = "Korisničko ime" })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required", placeholder = "Email adresa" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Password, new { @class = "control-label col-md-3" })
                        <div class="col-md-9">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", required = "required", placeholder = "Lozinka (min. 6 karaktera)" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label col-md-3">Potvrdi Lozinku</label>
                        <div class="col-md-9">
                            <input type="password" name="confirmPassword" class="form-control" required="required" placeholder="Ponovi lozinku" />
                            <span id="confirmPasswordError" class="text-danger"></span> <!-- Client-side match check optional -->
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-3 col-md-9">
                            <input type="submit" value="Registruj Se" class="btn btn-primary" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Zatvori</button>
                <p class="text-muted">Već imate nalog? <a href="@Url.Action("Login", "Nalozi")" target="_blank">Prijavite se ovde</a>.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            const isAuth = @isAuthenticated.ToString().ToLower();

            $('#addReviewBtn').click(function () {
                if (isAuth === 'true') {
                    $('#addReviewForm').toggle();
                } else {
                    $('#registerModal').modal('show');
                }
            });

            $('#cancelReviewBtn').click(function () {
                $('#addReviewForm').hide();
            });

            // Optional: Client-side password match check
            $('#registerFormInModal input[name="confirmPassword"]').on('input', function () {
                var password = $('#Password').val();
                var confirm = $(this).val();
                if (password !== confirm) {
                    $('#confirmPasswordError').text('Lozinke se ne poklapaju.');
                } else {
                    $('#confirmPasswordError').text('');
                }
            });

            // AJAX for Modal Registration
            $('#registerFormInModal').submit(function (e) {
                e.preventDefault();
                var formData = $(this).serialize(); // Includes anti-forgery token and model fields

                $.ajax({
                    url: '@Url.Action("RegisterModal", "Home")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            alert(response.message); // Or use a better toast notification
                            $('#registerModal').modal('hide');
                            location.reload(); // Refresh page to update auth state and show review form
                        } else {
                            var errors = response.errors.join('<br/>');
                            $('#modalErrors').html('<div class="alert alert-danger">' + errors + '</div>');
                        }
                    },
                    error: function (xhr, status, error) {
                        alert('Greška pri registraciji: ' + error + '. Pokušajte ponovo ili se prijavite.');
                    }
                });
            });
        });
    </script>
}
