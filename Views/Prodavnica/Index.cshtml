@model List<A_Gde_Si_Ti_Pub.Models.Proizvod>
@using A_Gde_Si_Ti_Pub.Models
@{
    ViewBag.Title = "Prodavnica";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool MozeKorpa = ViewBag.MozeKorpa as bool? ?? false;
}

<div class="container">
    <h2>Naša Prodavnica - Merch</h2>
    <p>Izaberite proizvode iz naše kolekcije.</p>

    @if (!User.Identity.IsAuthenticated)
    {
        <div class="alert alert-info">
            <p>Ulogujte se da biste dodali u korpu i naručili.</p>
            @Html.ActionLink("Prijavi Se", "Login", "Nalozi", new { returnUrl = Request.RawUrl }, new { @class = "btn btn-primary" })
        </div>
    }
    else if (!MozeKorpa)
    {
        <div class="alert alert-warning">
            <p>Možete pregledati proizvode, ali nemate dozvolu za kupovinu (kontaktirajte admina).</p>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

<div class="row">
    @foreach (var proizvod in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="@Url.Content(proizvod.Slika)" class="card-img-top" alt="@proizvod.Naziv" style="height: 200px; object-fit: cover;" />
                <div class="card-body">
                    <h5 class="card-title">@proizvod.Naziv</h5>
                    <p class="card-text">@proizvod.Opis</p>
                    <p class="text-primary h5">@proizvod.Cena.ToString("C")</p> <!-- e.g., 25,00 RSD -->
                </div>
                <div class="card-footer">
                    @if (MozeKorpa)
                    {
                        using (Html.BeginForm("DodajUKorpu", "Prodavnica", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("proizvodId", proizvod.ProizvodId)
                            <div class="input-group">
                                <input type="number" name="kolicina" value="1" min="1" class="form-control" style="width: 80px;" />
                                <button type="submit" class="btn btn-success">Dodaj u Korpu</button>
                            </div>
                        }
                    }
                    else
                    {   //neulogovan korisnik
                        <a href="@Url.Action("Login", "Nalozi", new { returnUrl = Request.RawUrl })" class="btn btn-outline-secondary">
                            Dodaj u Korpu <small>(Ulogujte se)</small>
                        </a>
                    }
                </div>
            </div>
        </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <img src="@Url.Content(proizvod.Slika)" class="card-img-top" alt="@proizvod.Naziv" style="height: 200px; object-fit: cover;" />
            <div class="card-body">
                <h5 class="card-title">@proizvod.Naziv</h5>
                <p class="card-text">@proizvod.Opis</p>
                <p class="text-primary h5">@proizvod.Cena.ToString("C")</p> <!-- e.g., 25,00 RSD -->
            </div>
            <div class="card-footer">
                @if (MozeKorpa)
                {
                    using (Html.BeginForm("DodajUKorpu", "Prodavnica", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("proizvodId", proizvod.ProizvodId)
                        <div class="input-group">
                            <input type="number" name="kolicina" value="1" min="1" class="form-control" style="width: 80px;" />
                            <button type="submit" class="btn btn-success">Dodaj u Korpu</button>
                        </div>
                    }
                }
                else
                {   //neulogovan korisnik
                    <a href="@Url.Action("Login", "Nalozi", new { returnUrl = Request.RawUrl })" class="btn btn-outline-secondary">
                        Dodaj u Korpu <small>(Ulogujte se)</small>
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <img src="@Url.Content(proizvod.Slika)" class="card-img-top" alt="@proizvod.Naziv" style="height: 200px; object-fit: cover;" />
            <div class="card-body">
                <h5 class="card-title">@proizvod.Naziv</h5>
                <p class="card-text">@proizvod.Opis</p>
                <p class="text-primary h5">@proizvod.Cena.ToString("C")</p> <!-- e.g., 25,00 RSD -->
            </div>
            <div class="card-footer">
                @if (MozeKorpa)
                {
                    using (Html.BeginForm("DodajUKorpu", "Prodavnica", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("proizvodId", proizvod.ProizvodId)
                        <div class="input-group">
                            <input type="number" name="kolicina" value="1" min="1" class="form-control" style="width: 80px;" />
                            <button type="submit" class="btn btn-success">Dodaj u Korpu</button>
                        </div>
                    }
                }
                else
                {   //neulogovan korisnik
                    <a href="@Url.Action("Login", "Nalozi", new { returnUrl = Request.RawUrl })" class="btn btn-outline-secondary">
                        Dodaj u Korpu <small>(Ulogujte se)</small>
                    </a>
                }
            </div>
        </div>
    </div>
    }
</div>

    @if (Model.Count == 0)
    {
        <p>Nema dostupnih proizvoda. Vratite se kasnije!</p>
    }
    @if (MozeKorpa && (Session["Korpa"] as List<DeloviPorudzbine>)?.Any() == true)
    {
        <div class="text-center mt-4">
            <a href="@Url.Action("KreirajPorudzbinu", "Prodavnica")" class="btn btn-info">
                Pogledaj Korpu (@((Session["Korpa"] as List<DeloviPorudzbine>)?.Count ?? 0) stavki)
            </a>
        </div>
    }
</div>
