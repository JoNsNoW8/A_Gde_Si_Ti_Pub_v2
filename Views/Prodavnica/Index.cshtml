@model List<A_Gde_Si_Ti_Pub.Models.Proizvod>
@using A_Gde_Si_Ti_Pub.Models
@{
    ViewBag.Title = "Prodavnica";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool MozeKorpa = ViewBag.MozeKorpa as bool? ?? false;
}

<div class="container">
    <h2 style="padding-top:10px" class="naslov">Naša Prodavnica</h2>
    <p class="podnaslov">Izaberite proizvode iz naše kolekcije.</p>

    @if (!User.Identity.IsAuthenticated)
    {
        <div class="alert alert-info">
            <p>Dobrodošli! Možete pregledati proizvode, ali se ulogujte da biste dodali u korpu i naručili.</p>
            @Html.ActionLink("Prijavi Se", "Login", "Nalozi", new { returnUrl = Request.RawUrl }, new { @class = "btn btn-primary" })
        </div>
    }
    else
    {
        var customUser = User as A_Gde_Si_Ti_Pub.Models.CustomPrincipal;
        if (customUser?.IsInRole("Korisnik") != true)
        {
            <!-- NEW: Specific message for Admin or other roles -->
            <div class="alert alert-warning">
                <p>
                    Vaš nalog (@User.Identity.Name) ne podržava kupovinu (samo Korisnik uloga).
                    <a href="@Url.Action("Profil", "Home")">Pogledajte profil</a> ili
                    <a href="@Url.Action("Logout", "Nalozi")">odjavite se</a> i ulogujte se sa Korisnik nalogom.
                </p>
            </div>
        }
        else
        {
            <!-- For Korisnik: No message needed -->
        }
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row">
        @foreach (var proizvod in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@Url.Content(proizvod.Slika ?? "~/Content/Proizvodi/majica.jpg")"
                         class="card-img-top"
                         alt="@proizvod.Naziv"
                         style="height: 200px; object-fit: cover;"
                         onerror="this.src='https://via.placeholder.com/300x200?text=No+Image';" />
                    <div class="card-body">
                        <h5 class="card-title kartica">@proizvod.Naziv</h5>
                        <p class="card-text proizvod">@proizvod.Opis</p>
                        <div>
                            <p class="text-primary h5 proizvod mb-0" style="padding-top:15px">@($"{proizvod.Cena:N2} RSD")</p>
                        </div>

                    </div>
                    <div class="card-footer">
                        @if (MozeKorpa)
                        {
                                using (Html.BeginForm("DodajUKorpu", "Prodavnica", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("proizvodId", proizvod.ProizvodId)
                                    <div class="input-group">
                                        <input type="number" name="kolicina" value="1" min="1" step="1" class="form-control proizvod" style="width: 80px;" placeholder="Količina" />
                                        <button type="submit" class="btn btn-success proizvod">Dodaj u Korpu</button>
                                    </div>
                                }
                        }
                        else
                        {   //neulogovan korisnik
                            <a href="@Url.Action("Login", "Nalozi", new { returnUrl = Request.RawUrl })" class="btn btn-outline-secondary">
                                Dodaj u Korpu <small>(Ulogujte se)</small>
                            </a>
                        }
                    </div>
                </div>
            </div>

        }
    </div>

    @if (Model.Count == 0)
    {
        <p>Nema dostupnih proizvoda. Vratite se kasnije!</p>
    }
</div>
