@model List<A_Gde_Si_Ti_Pub.Models.DeloviPorudzbine>
@{
    ViewBag.Title = "Korpa";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal ukupnaCena = ViewBag.UkupnaCena as decimal? ?? 0;
}

<h2 class="naslov">Vaša korpa</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-info">@ViewBag.Message</div>
    <p>@Html.ActionLink("Nastavi kupovinu", "Index", "Prodavnica", null, new { @class = "btn btn-primary" })</p>
}
else if (!Model.Any())
{
    <div class="alert alert-info">Korpa je prazna.</div>
    <p>@Html.ActionLink("Idi na prodavnicu", "Index", "Prodavnica", null, new { @class = "btn btn-primary" })</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Proizvod</th>
                <th>Količina</th>
                <th>Cena po komadu</th>
                <th>Ukupna cena</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Proizvod.Naziv</strong><br />
                    </td>
                    <td>
                        <span class="d-inline-block text-center" style="width: 40px;">@item.Kolicina</span>
                    </td>
                    <td>@($"{item.Cena:N2} RSD")</td>
                    <td id="subtotal-@item.ProizvodId">@($"{item.Subtotal:N2} RSD")</td>
                    <td>
                        <button class="btn btn-danger btn-sm" onclick="ukloniIzKorpe(@item.ProizvodId)" id="ukloni-@item.ProizvodId">
                            Ukloni
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-info">
                <th colspan="3">Ukupno:</th>
                <th id="ukupno">@($"{ukupnaCena:N2} RSD")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="text-center mt-4">
        @using (Html.BeginForm("KreirajPorudzbinu", "Prodavnica", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success btn-lg">
                Nastavi
            </button>
        }
        <br />
        @Html.ActionLink("Nastavi kupovinu", "Index", "Prodavnica", null, new { @class = "btn btn-secondary" })
    </div>
}
@Html.AntiForgeryToken()

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        let updateTimeout;

        function azurirajKolicinuNaPromenu(proizvodId) { //koirsnik menja kolicinu u korpi
            clearTimeout(updateTimeout);
            updateTimeout = setTimeout(function() {
                var kolicina = parseInt($('#kolicina-' + proizvodId).val()) || 1;
                azurirajKolicinu(proizvodId, kolicina);
            }, 500);
        }


        function azurirajKolicinu(proizvodId, kolicina) { 
            var btn = $('#ukloni-' + proizvodId);
            btn.prop('disabled', true).text('Ažuriram...');

            $.post('@Url.Action("AzurirajKorpu", "Prodavnica")',
                {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    proizvodId: proizvodId, kolicina: kolicina
                }, function (data) {
                btn.prop('disabled', false).text('Ukloni');

                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Greška pri ažuriranju korpe.');
                    $('#kolicina-' + proizvodId).val(data.subtotal > 0 ? (kolicina || 1) : 1);
                }
            }).fail(function() {
                btn.prop('disabled', false).text('Ukloni');
                alert('Greška u konekciji. Pokušajte ponovo.');
            });
        }

        function ukloniIzKorpe(proizvodId) {
            if (confirm('Sigurno ukloniti ovu stavku iz korpe?')) {
                azurirajKolicinu(proizvodId, 0);
            }
        }
    </script>
}
