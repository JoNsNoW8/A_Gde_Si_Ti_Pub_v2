@model List<A_Gde_Si_Ti_Pub.Models.Porudzbina>
@{
    ViewBag.Title = "Moje Porudžbine";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="naslov">Moje porudžbine</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p class="podnaslov">Ovde možete pregledati vašu istoriju porudžbina.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <p>Nemate nijednu porudžbinu. <a href="@Url.Action("Index", "Prodavnica")">Nastavite kupovinu</a> da biste kreirali prvu.</p>
    </div>
}
else
{
    <table class="table table-bordered table-striped proizvod">
        <thead class="thead-dark">
            <tr>
                <th>ID Porudžbine</th>
                <th>Datum</th>
                <th>Ukupna cena</th>
                <th>Status</th>
                <th>Proizvodi</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var porudzbina in Model)
            {
                <tr>
                    <td><strong>#@porudzbina.PorudzbinaId</strong></td>
                    <td>@porudzbina.Datum.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-success">@($"{porudzbina.UkupnaCena:N2} RSD")</td>
                    <td>
                        <span style="color:black" class="badge badge-@(porudzbina.Status == "Obrada" ? "warning" : porudzbina.Status == "Poslato" ? "info" : "success")">
                            @porudzbina.Status
                        </span>
                    </td>
                    <td>
                        @if (porudzbina.DeloviPorudzbine != null && porudzbina.DeloviPorudzbine.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var deo in porudzbina.DeloviPorudzbine.Take(3)) // Show first 3
                                {
                                    <li>
                                        @deo.Proizvod.Naziv - @deo.Cena.ToString("N2") RSD po kom
                                    </li>
                                }
                                @if (porudzbina.DeloviPorudzbine.Count > 3)
                                {
                                    <li class="text-muted">... i još @(porudzbina.DeloviPorudzbine.Count - 3) stavki</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">Nema stavki</span>
                        }
                    </td>
                    <td>
                        <!-- Optional: Link to order details (add action/view later if needed) -->
                        @Html.ActionLink("Detalji", "DetaljiPorudzbine", new { id = porudzbina.PorudzbinaId }, new { @class = "btn btn-info btn-sm proizvod" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Summary -->
    <div class="text-center mt-3">
        <p class="proizvod">Ukupno porudžbina: @Model.Count</p>
        @Html.ActionLink("Nova porudžbina", "Index", "Prodavnica", null, new { @class = "btn btn-primary proizvod" })
        @Html.ActionLink("Moj profil", "Profil", "Home", null, new { @class = "btn btn-secondary proizvod" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <!-- No additional JS needed -->
}
