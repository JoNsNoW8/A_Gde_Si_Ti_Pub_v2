@model List<A_Gde_Si_Ti_Pub.Models.Porudzbina>
@{
    ViewBag.Title = "Moje Porudžbine";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Moje Porudžbine</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>Ovdje možete pregledati vašu istoriju porudžbina.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <p>Nemate nijednu porudžbinu. <a href="@Url.Action("Index", "Prodavnica")">Nastavite kupovinu</a> da biste kreirali prvu.</p>
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr>
                <th>ID Porudžbine</th>
                <th>Datum</th>
                <th>Ukupna Cena</th>
                <th>Status</th>
                <th>Stavke (Proizvodi)</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var porudzbina in Model)
            {
                <tr>
                    <td><strong>#@porudzbina.PorudzbinaId</strong></td>
                    <td>@porudzbina.Datum.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-success">@porudzbina.UkupnaCena.ToString("C")</td>
                    <td>
                        <span class="badge badge-@(porudzbina.Status == "Obrada" ? "warning" : porudzbina.Status == "Poslato" ? "info" : "success")">
                            @porudzbina.Status
                        </span>
                    </td>
                    <td>
                        @if (porudzbina.DeloviPorudzbine != null && porudzbina.DeloviPorudzbine.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var deo in porudzbina.DeloviPorudzbine.Take(3)) // Show first 3
                                {
                                    <li>
                                        @deo.Proizvod?.Naziv (x@deo.Kolicina) - @deo.Cena.ToString("C") po kom
                                    </li>
                                }
                                @if (porudzbina.DeloviPorudzbine.Count > 3)
                                {
                                    <li class="text-muted">... i još @(porudzbina.DeloviPorudzbine.Count - 3) stavki</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">Nema stavki</span>
                        }
                    </td>
                    <td>
                        <!-- Optional: Link to order details (add action/view later if needed) -->
                        @Html.ActionLink("Detalji", "#", null, new { @class = "btn btn-info btn-sm", onclick = "alert('Detalji porudžbine u razvoju.'); return false;" }) <!-- Placeholder -->
                        <!-- If you want delete for user (optional - usually admin only) -->
                        <!-- @using (Html.BeginForm("ObrisiPorudzbinu", "Prodavnica", new { porudzbinaId = porudzbina.PorudzbinaId }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Sigurno obriši ovu porudžbinu?');">
                                Obriši
                            </button>
                        } -->
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Summary -->
    <div class="text-center mt-3">
        <p>Ukupno porudžbina: @Model.Count</p>
        @Html.ActionLink("Nova Porudžbina", "Index", "Prodavnica", null, new { @class = "btn btn-primary" })
        @Html.ActionLink("Moj Profil", "Profil", "Home", null, new { @class = "btn btn-secondary" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <!-- No additional JS needed -->
}
